# ==============================================================================
# Dynamic Grid — Binance Spot Trading Configuration
# ==============================================================================

# ── Binance API Credentials ───────────────────────────────────────────────────
# Get your API Key & Secret from Binance: Profile -> API Management
# For Spot trading, enable: "Can Read" and "Enable Spot & Margin Trading"
# Leave empty if testing in DRY_RUN=true mode with public market data
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# ── Trading Pair & Asset ──────────────────────────────────────────────────────
# Default pair to trade on Binance (e.g. BTCUSDT, ETHUSDT, SOLUSDT, BNBUSDT)
SYMBOL=BTCUSDT

# ── Execution Mode ────────────────────────────────────────────────────────────
# Set to 'true' to simulate trading without sending real orders to Binance
# Set to 'false' to trade live on Binance Spot with your API credentials
DRY_RUN=true

# ── Strategy Risk Knobs (Defaults) ───────────────────────────────────────────
# Maximum inventory capacity allocated to holding positions (in USDT)
GRID_MAX_INVENTORY_USDSO=40

# Tick loop poll interval in milliseconds (default 500ms)
DGRID_INTERVAL_MS=500

# Channel mode: DOW_ATR_CLAMP, FIXED_PCT_CLAMP, DONCHIAN_ATR, or MULTI_TOUCH_SR
CHANNEL_MODE=MULTI_TOUCH_SR

# Dow Theory & Trend Timeframes
DOW_TIMEFRAME=15m
TREND_TIMEFRAME=1h

# Timezone for log timestamps
TZ=Asia/Bangkok
PORT=3333
